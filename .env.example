# Offline/local default. Set LLM_PROVIDER=evren to use the optional hosted provider.
LLM_PROVIDER=ollama
EVREN_API_KEY=
EVREN_BASE_URL=
EVREN_MODEL_FAST=llm-fast
EVREN_MODEL_LARGE=llm-large
EVREN_TIMEOUT_SECONDS=60

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
# Demo sırasında modelin gereksiz unload/reload olmasını önler.
OLLAMA_KEEP_ALIVE=30m

MANUAL_BASELINE_SECONDS=300

# Opsiyonel: ROI hesaplaması için saatlik personel maliyeti (TRY)
PERSONNEL_HOURLY_COST_TRY=
