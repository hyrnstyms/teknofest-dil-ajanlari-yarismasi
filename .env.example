# Offline/local default. Set LLM_PROVIDER=evren to use the optional hosted provider.
LLM_PROVIDER=ollama
EVREN_API_KEY=
EVREN_BASE_URL=
EVREN_MODEL_FAST=llm-fast
EVREN_MODEL_LARGE=llm-large
EVREN_TIMEOUT_SECONDS=60

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
# Demo sırasında modelin gereksiz unload/reload olmasını önler.
OLLAMA_KEEP_ALIVE=30m

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=60

# Kalıcı runtime analiz/review depolaması
DATABASE_URL=postgresql+psycopg://kamuai:kamuai@localhost:5432/kamuai

MANUAL_BASELINE_SECONDS=300

# Opsiyonel: ROI hesaplaması için saatlik personel maliyeti (TRY)
PERSONNEL_HOURLY_COST_TRY=

# Yalnız yerel yarışma demosunda persona/senaryo/citizen yardımcılarını açar.
DEMO_MODE=false
